@page
@model StorePos.Web.Pages.Requests.IndexModel
@{ ViewData["Title"] = "Solicitudes de clientes"; }
<div class="toolbar"><h1>Productos que piden los clientes</h1><span class="spacer"></span>
    @if (Model.IsManager) { <a class="btn" href="/Reports/Export?handler=Requests">Exportar a Excel</a> }</div>
<form method="post" asp-page-handler="Add" class="card">
    <h2>Registro rápido</h2>
    <div class="form-grid">
        <label>¿Qué pidió el cliente? * <input name="productName" required maxlength="150" autofocus placeholder="Ej. Squirt 2 L" /></label>
        <label>Código de barras (si lo trae) <input name="barcode" maxlength="64" /></label>
        <label>Categoría <select name="categoryId"><option value="">—</option>@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }</select></label>
        <label>Cantidad (si la dijo) <input name="quantity" type="number" min="0" value="0" /></label>
        <label>Notas <input name="notes" maxlength="300" /></label>
    </div>
    <button class="btn primary">Registrar solicitud</button>
    <span class="muted small">Si ya existe una solicitud con el mismo nombre o código, se suma al contador.</span>
</form>
<form method="get" class="toolbar">
    <label>Buscar <input name="q" value="@Model.Q" /></label>
    <label>Estado
        <select name="status" data-autosubmit>
            @foreach (var s in Enum.GetValues<RequestStatus>()) { <option value="@s" selected="@(Model.Status == s)">@DisplayNames.Of(s)</option> }
        </select>
    </label>
    <a class="btn" href="?all=1">Ver todas</a>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>Producto</th><th>Categoría</th><th class="num">Veces pedido</th><th class="num">Cantidad pedida</th><th>Primera vez</th><th>Última vez</th><th>Catálogo</th><th>Estado</th><th>Notas</th>@if (Model.IsManager) { <th></th> }</tr></thead>
    <tbody>
    @foreach (var r in Model.Result.Items)
    {
        <tr>
            <td>@r.ProductName <span class="muted small">@r.Barcode</span></td><td>@r.Category?.Name</td>
            <td class="num"><strong>@r.RequestCount</strong></td><td class="num">@(r.TotalQuantity > 0 ? r.TotalQuantity.ToString() : "—")</td>
            <td>@F.D(r.FirstRequestedAt)</td><td>@F.D(r.LastRequestedAt)</td>
            <td>@if (r.Product is not null) { <a href="/Inventory/Product?id=@r.ProductId">@r.Product.Name</a> } else if (Model.IsManager) { <a href="/Products/Edit?name=@Uri.EscapeDataString(r.ProductName)&barcode=@Uri.EscapeDataString(r.Barcode ?? "")">Dar de alta</a> }</td>
            <td><span class="badge @(r.Status == RequestStatus.Pending ? "warn" : r.Status == RequestStatus.Stocked ? "ok" : "")">@DisplayNames.Of(r.Status)</span></td>
            <td class="small">@r.Notes</td>
            @if (Model.IsManager)
            {
                <td>
                    <form method="post" asp-page-handler="Status" class="toolbar" style="margin:0">
                        <input type="hidden" name="id" value="@r.Id" />
                        <select name="newStatus">@foreach (var s in Enum.GetValues<RequestStatus>()) { <option value="@s" selected="@(r.Status == s)">@DisplayNames.Of(s)</option> }</select>
                        <button class="btn small">Cambiar</button>
                    </form>
                </td>
            }
        </tr>
    }
    @if (Model.Result.Items.Count == 0) { <tr><td colspan="10" class="muted">Sin solicitudes.</td></tr> }
    </tbody>
</table>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result, Request)" />
