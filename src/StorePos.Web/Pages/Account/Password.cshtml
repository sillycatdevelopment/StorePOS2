@page
@model StorePos.Web.Pages.Account.PasswordModel
@{ ViewData["Title"] = "Cambiar contraseña"; }
<h1>Cambiar contraseña</h1>
<form method="post" class="card narrow">
    <label>Contraseña actual <input type="password" name="Current" required autocomplete="current-password" /></label>
    <label>Nueva contraseña <input type="password" name="New" required minlength="4" autocomplete="new-password" /></label>
    <button class="btn primary">Guardar</button>
</form>
