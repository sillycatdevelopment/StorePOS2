@page
@model StorePos.Web.Pages.Owners.IndexModel
@{ ViewData["Title"] = "Dueños"; }
<div class="toolbar"><h1>Dueños de la mercancía</h1><span class="spacer"></span><a class="btn primary" href="/Owners/Edit">+ Nuevo dueño</a></div>
<form method="get" class="toolbar card">
    <partial name="_PeriodPicker" model="(Model.Period, Model.Range.From, Model.Range.To)" />
    <button class="btn">Ver</button>
    <span class="muted small">@F.D(Model.Range.From) al @F.D(Model.Range.To)</span>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>Dueño</th><th>Contacto</th><th class="num">Productos con existencia</th><th class="num">Inventario a costo</th><th class="num">Inventario a precio venta</th>
        <th class="num">Ingresos del periodo</th><th class="num">Costo</th><th class="num">Ganancia bruta</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model.Stats)
    {
        <tr>
            <td>@s.Owner.Name @if (!s.Owner.IsActive) { <span class="badge">inactivo</span> }</td>
            <td class="small">@s.Owner.Contact</td>
            <td class="num">@s.ProductsInStock</td>
            <td class="num">@F.M(s.InventoryCostCents)</td><td class="num">@F.M(s.InventoryRetailCents)</td>
            <td class="num">@F.M(s.RevenueCents)</td><td class="num">@F.M(s.CostCents)</td><td class="num"><strong>@F.M(s.ProfitCents)</strong></td>
            <td class="actions">
                <a class="btn small" href="/Inventory?ownerId=@s.Owner.Id">Inventario</a>
                <a class="btn small" href="/Sales?ownerId=@s.Owner.Id&from=@F.Iso(Model.Range.From)&to=@F.Iso(Model.Range.To)">Ventas</a>
                <a class="btn small" href="?handler=Export&ownerId=@s.Owner.Id&period=Custom&from=@F.Iso(Model.Range.From)&to=@F.Iso(Model.Range.To)">Excel</a>
                <a class="btn small" href="/Owners/Edit?id=@s.Owner.Id">Editar</a>
            </td>
        </tr>
    }
    <tr class="total"><td colspan="3">Total</td>
        <td class="num">@F.M(Model.Stats.Sum(s => s.InventoryCostCents))</td><td class="num">@F.M(Model.Stats.Sum(s => s.InventoryRetailCents))</td>
        <td class="num">@F.M(Model.Stats.Sum(s => s.RevenueCents))</td><td class="num">@F.M(Model.Stats.Sum(s => s.CostCents))</td>
        <td class="num">@F.M(Model.Stats.Sum(s => s.ProfitCents))</td><td></td></tr>
    </tbody>
</table>
</div>
<p class="muted small">Cada venta guarda de qué dueño salió la mercancía y a qué costo; estos totales no mezclan el inventario de distintos dueños.</p>
