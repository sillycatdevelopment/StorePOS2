@page
@model StorePos.Web.Pages.Sales.IndexModel
@{ ViewData["Title"] = "Historial de ventas"; }
<div class="toolbar"><h1>Historial de ventas</h1><span class="spacer"></span>@if (Model.IsManager) { <a class="btn" href="/Reports/Export">Exportar a Excel</a> }</div>
<form method="get" class="toolbar card">
    <label>Folio <input name="folio" type="number" value="@Model.Folio" style="width:90px;min-width:0" /></label>
    <label>Desde <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label>
    <label>Hasta <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label>
    <label>Producto <input name="product" value="@Model.Product" placeholder="Nombre o código" /></label>
    <label>Pago
        <select name="paymentMethodId">
            <option value="">Todos</option>
            @foreach (var m in Model.Methods) { <option value="@m.Id" selected="@(Model.PaymentMethodId == m.Id)">@m.Name</option> }
        </select>
    </label>
    <label>Dueño
        <select name="ownerId">
            <option value="">Todos</option>
            @foreach (var o in Model.Owners) { <option value="@o.Id" selected="@(Model.OwnerId == o.Id)">@o.Name</option> }
        </select>
    </label>
    <label>Estado
        <select name="status">
            <option value="">Todas</option>
            <option value="Completed" selected="@(Model.Status == SaleStatus.Completed)">Completadas</option>
            <option value="Cancelled" selected="@(Model.Status == SaleStatus.Cancelled)">Canceladas</option>
        </select>
    </label>
    <button class="btn">Buscar</button>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>Folio</th><th>Fecha</th><th class="num">Renglones</th><th>Pago</th><th class="num">Total</th>@if (Model.IsManager) { <th class="num">Ganancia</th> }<th>Cajero</th><th>Estado</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model.Result.Items)
    {
        <tr class="@(s.Status == SaleStatus.Cancelled ? "cancelled" : "")">
            <td>@s.Id</td><td>@F.DT(s.CreatedAt)</td><td class="num">@s.ItemCount</td><td>@s.PaymentMethodName</td>
            <td class="num">@F.M(s.TotalCents)</td>@if (Model.IsManager) { <td class="num">@F.M(s.ProfitCents)</td> }<td>@s.UserName</td>
            <td>@(s.Status == SaleStatus.Cancelled ? "Cancelada" : "Completada")</td>
            <td class="actions"><a class="btn small" href="/Sales/Details?id=@s.Id">Ver</a><a class="btn small" href="/Sales/Receipt?id=@s.Id" target="_blank">Ticket</a></td>
        </tr>
    }
    @if (Model.Result.Items.Count == 0) { <tr><td colspan="9" class="muted">Sin ventas con esos filtros.</td></tr> }
    </tbody>
</table>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result, Request)" />
