@page
@model StorePos.Web.Pages.Pos.IndexModel
@{ ViewData["Title"] = "Punto de venta"; }
@Html.AntiForgeryToken()

@if (Model.OpenDay is null)
{
    <div class="alert warn">La caja está cerrada. <a href="/Cash">Abre la caja</a> para poder cobrar.</div>
}

<div class="pos" id="pos"
     data-manager="@(Model.IsManager ? "1" : "0")"
     data-mode="@((int)Model.Mode)"
     data-open="@(Model.OpenDay is null ? "0" : "1")"
     data-owners="@System.Text.Json.JsonSerializer.Serialize(Model.Owners.Select(o => new { id = o.Id, name = o.Name }))">
    <section>
        <div class="card">
            <label>Escanea el código de barras o escribe el nombre <span class="kbd">F2</span>
                <input id="scan" class="scan" autocomplete="off" autofocus placeholder="Código o nombre del producto…" />
            </label>
            <div id="results" class="results" hidden></div>
            <div id="msg" class="small"></div>
        </div>
        <div class="card">
            <div class="table-wrap">
            <table class="cart">
                <thead><tr><th>Producto</th><th>Dueño</th><th class="num">Cantidad</th><th class="num">Precio</th>
                    <th class="num manager-only">Desc. $</th><th class="num">Importe</th><th></th></tr></thead>
                <tbody id="cart"><tr class="empty"><td colspan="7" class="muted">Sin productos. Escanea o busca para agregar.</td></tr></tbody>
            </table>
            </div>
            <div class="actions">
                <button type="button" class="btn" id="clear">Vaciar venta <span class="kbd">Esc×2</span></button>
                <a class="btn" href="/Requests" target="_blank">Registrar producto solicitado</a>
            </div>
        </div>
    </section>
    <aside>
        <div class="card">
            <div class="muted small">Subtotal: <span id="subtotal">$0.00</span></div>
            <div class="muted small manager-only">Descuento: <span id="discountTotal">$0.00</span></div>
            <div class="total-box" id="total">$0.00</div>
            <div class="pay-methods" id="methods">
                @foreach (var m in Model.Methods)
                {
                    <button type="button" class="btn" data-id="@m.Id" data-cash="@(m.IsCash ? "1" : "0")">@m.Name</button>
                }
            </div>
            <div id="cashBox">
                <label>Efectivo recibido <input id="received" type="number" step="0.01" min="0" class="money" style="width:100%" /></label>
                <div class="change">Cambio: <span id="change">$0.00</span></div>
            </div>
            <div class="manager-only">
                <label>Descuento a toda la venta ($) <input id="ticketDiscount" type="number" step="0.01" min="0" value="0" /></label>
                <label class="check"><input type="checkbox" id="authorize" /> Autorizar venta sin existencia</label>
            </div>
            <label>Nota (opcional) <input id="notes" maxlength="200" /></label>
            <button type="button" class="btn primary wide" id="pay" style="font-size:1.2rem;padding:12px">Cobrar <span class="kbd">F9</span></button>
        </div>
        <div class="card" id="lastSale" hidden>
            <div><strong>Venta registrada</strong> <span id="lastId"></span></div>
            <div>Total: <span id="lastTotal"></span> · Cambio: <strong id="lastChange"></strong></div>
            <div class="actions" style="margin-top:8px">
                <a class="btn small" id="lastReceipt" target="_blank">Imprimir ticket</a>
            </div>
        </div>
    </aside>
</div>
@section Scripts {
<script src="~/js/pos.js" asp-append-version="true"></script>
}
