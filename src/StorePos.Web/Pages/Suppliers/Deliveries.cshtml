@page
@model StorePos.Web.Pages.Suppliers.DeliveriesModel
@{ ViewData["Title"] = "Historial de entregas"; }
<div class="toolbar"><h1>Historial de entregas</h1><span class="spacer"></span><a class="btn primary" href="/Suppliers/Delivery">Registrar entrega</a></div>
<form method="get" class="toolbar card">
    <partial name="_PeriodPicker" model="(Model.Period, Model.Range.From, Model.Range.To)" />
    <label>Proveedor
        <select name="supplierId">
            <option value="">Todos</option>
            @foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option> }
        </select>
    </label>
    <button class="btn">Ver</button>
    <button class="btn" name="handler" value="Export">Exportar a Excel</button>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>#</th><th>Fecha</th><th>Proveedor</th><th>Factura</th><th class="num">Renglones</th><th class="num">Costo total</th><th>Recibió</th></tr></thead>
    <tbody>
    @foreach (var d in Model.Result.Items)
    {
        <tr><td><a href="/Suppliers/DeliveryDetails?id=@d.Id">@d.Id</a></td><td>@F.DT(d.ReceivedAt)</td><td>@d.SupplierName</td><td>@d.InvoiceNumber</td>
            <td class="num">@d.ItemCount</td><td class="num">@F.M(d.TotalCostCents)</td><td>@d.UserName</td></tr>
    }
    @if (Model.Result.Items.Count == 0) { <tr><td colspan="7" class="muted">Sin entregas en el periodo.</td></tr> }
    </tbody>
</table>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result, Request)" />
