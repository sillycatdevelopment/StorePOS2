@page
@model StorePos.Web.Pages.Inventory.MovementsModel
@{ ViewData["Title"] = "Movimientos de inventario"; }
<h1>Movimientos de inventario</h1>
<form method="get" class="toolbar card">
    <label>Desde <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label>
    <label>Hasta <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label>
    <label>Tipo
        <select name="type">
            <option value="">Todos</option>
            @foreach (var t in Enum.GetValues<MovementType>()) { <option value="@t" selected="@(Model.Type == t)">@DisplayNames.Of(t)</option> }
        </select>
    </label>
    <label>Dueño
        <select name="ownerId">
            <option value="">Todos</option>
            @foreach (var o in Model.Owners) { <option value="@o.Id" selected="@(Model.OwnerId == o.Id)">@o.Name</option> }
        </select>
    </label>
    <button class="btn">Filtrar</button>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Dueño</th><th class="num">Cantidad</th><th class="num">Costo</th><th class="num">Precio</th><th>Detalle</th><th>Usuario</th></tr></thead>
    <tbody>
    @foreach (var m in Model.Result.Items)
    {
        <tr><td class="nowrap">@F.DT(m.CreatedAt)</td><td><a href="/Inventory/Product?id=@m.ProductId">@m.ProductName</a></td><td>@DisplayNames.Of(m.Type)</td><td>@m.OwnerName</td>
            <td class="num">@(m.Quantity > 0 ? "+" : "")@F.Q(m.Quantity, m.Unit)</td><td class="num">@F.M(m.UnitCostCents)</td>
            <td class="num">@(m.UnitPriceCents is long up ? F.M(up) : "")</td>
            <td class="small">@m.Reason @if (m.SaleId is int sid) { <a href="/Sales/Details?id=@sid">venta #@sid</a> }</td><td>@m.UserName</td></tr>
    }
    @if (Model.Result.Items.Count == 0) { <tr><td colspan="9" class="muted">Sin movimientos.</td></tr> }
    </tbody>
</table>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result, Request)" />
