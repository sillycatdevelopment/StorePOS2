@page
@model StorePos.Web.Pages.Products.EditModel
@{ ViewData["Title"] = Model.IsNew ? "Nuevo producto" : "Editar producto"; }
<h1>@ViewData["Title"]</h1>
<form method="post" class="card">
    <input type="hidden" asp-for="Input.Id" />
    <div class="form-grid">
        <label>Nombre * <input asp-for="Input.Name" required maxlength="150" autofocus /></label>
        <label>Código de barras <input asp-for="Input.Barcode" maxlength="64" placeholder="Escanéalo aquí" onkeydown="if(event.key==='Enter')event.preventDefault()" /></label>
        <label>Categoría
            <select asp-for="Input.CategoryId">
                <option value="">Sin categoría</option>
                @foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }
            </select>
        </label>
        <label>Se vende por
            <select asp-for="Input.Unit">
                <option value="@UnitType.Piece">Pieza</option>
                <option value="@UnitType.Kilogram">Kilogramo (a granel)</option>
            </select>
        </label>
        <label>Precio de compra (referencia) <input asp-for="Input.PurchasePrice" type="number" step="0.01" min="0" /></label>
        <label>Precio de venta * <input asp-for="Input.SalePrice" type="number" step="0.01" min="0" required /></label>
        <label>Existencia mínima <input asp-for="Input.MinStock" type="number" step="0.001" min="0" /></label>
        <label>Proveedor habitual
            <select asp-for="Input.PreferredSupplierId">
                <option value="">Ninguno</option>
                @foreach (var s in Model.Suppliers) { <option value="@s.Id">@s.Name</option> }
            </select>
        </label>
        <label>Dueño prioritario (modo automático)
            <select asp-for="Input.PriorityOwnerId">
                <option value="">Ninguno</option>
                @foreach (var o in Model.Owners) { <option value="@o.Id">@o.Name</option> }
            </select>
        </label>
    </div>
    <label>Descripción <textarea asp-for="Input.Description" rows="2" maxlength="1000"></textarea></label>
    <label class="check"><input type="checkbox" asp-for="Input.IsActive" /> Activo (se puede vender)</label>

    @if (Model.IsNew)
    {
        <fieldset>
            <legend>Existencia inicial (opcional)</legend>
            <div class="form-grid">
                <label>Cantidad en el estante <input asp-for="Input.InitialQty" type="number" step="0.001" min="0" /></label>
                <label>¿De quién es?
                    <select asp-for="Input.InitialOwnerId">
                        <option value="">— elegir —</option>
                        @foreach (var o in Model.Owners) { <option value="@o.Id">@o.Name</option> }
                    </select>
                </label>
            </div>
            <p class="muted small">Se registra al precio de compra de referencia. Para varios dueños usa Inventario → Agregar existencia.</p>
        </fieldset>
    }
    <div class="actions">
        <button class="btn primary">Guardar</button>
        @if (Model.IsNew) { <button class="btn" name="next" value="new">Guardar y registrar otro</button> }
        <a class="btn" href="/Products">Cancelar</a>
    </div>
</form>
@if (!Model.IsNew)
{
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Input.Id" class="card narrow" data-confirm="¿Eliminar este producto? No se puede deshacer.">
        <h2>Eliminar producto</h2>
        <p class="muted small">Solo se puede eliminar si nunca tuvo inventario, ventas ni entregas. Si ya tiene historial, desactívalo (quita la casilla “Activo”).</p>
        <button class="btn danger">Eliminar</button>
    </form>
}
