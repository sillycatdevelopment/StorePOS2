@page
@model StorePos.Web.Pages.Settings.AuditModel
@{ ViewData["Title"] = "Bitácora de auditoría"; }
<h1>Bitácora de auditoría</h1>
<partial name="_Nav" />
<form method="get" class="toolbar card">
    <label>Desde <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></label>
    <label>Hasta <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></label>
    <label>Buscar <input name="q" value="@Model.Q" placeholder="Acción, usuario, detalle…" /></label>
    <button class="btn">Filtrar</button>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>Detalle</th></tr></thead>
    <tbody>
    @foreach (var a in Model.Result.Items)
    {
        <tr><td class="nowrap">@F.DT(a.CreatedAt)</td><td>@a.UserName</td><td>@a.Action</td><td class="small">@a.EntityType @a.EntityId</td><td class="small">@a.Details</td></tr>
    }
    @if (Model.Result.Items.Count == 0) { <tr><td colspan="5" class="muted">Sin registros.</td></tr> }
    </tbody>
</table>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result, Request)" />
