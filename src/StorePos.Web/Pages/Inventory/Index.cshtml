@page
@model StorePos.Web.Pages.Inventory.IndexModel
@{ ViewData["Title"] = "Inventario"; }
<div class="toolbar">
    <h1>Inventario</h1><span class="spacer"></span>
    <a class="btn" href="/Inventory/Movements">Historial de movimientos</a>
    @if (Model.IsManager)
    {
        <a class="btn" href="?handler=Export&kind=all&ownerId=@Model.OwnerId&categoryId=@Model.CategoryId&supplierId=@Model.SupplierId&q=@Model.Q">Exportar inventario</a>
        <a class="btn" href="?handler=Export&kind=low&ownerId=@Model.OwnerId&categoryId=@Model.CategoryId&supplierId=@Model.SupplierId">Exportar existencia baja</a>
        <a class="btn" href="?handler=Export&kind=out&ownerId=@Model.OwnerId&categoryId=@Model.CategoryId&supplierId=@Model.SupplierId">Exportar agotados</a>
    }
</div>
@if (Model.IsManager)
{
    <div class="grid k4" style="margin-bottom:14px">
        <div class="kpi"><div class="label">Valor a costo@(Model.OwnerId is null ? "" : " (dueño filtrado)")</div><div class="value">@F.M(Model.Value.Cost)</div></div>
        <div class="kpi"><div class="label">Valor a precio de venta</div><div class="value">@F.M(Model.Value.Retail)</div></div>
        <div class="kpi good"><div class="label">Ganancia potencial</div><div class="value">@F.M(Model.Value.Retail - Model.Value.Cost)</div></div>
    </div>
}
<form method="get" class="toolbar card">
    <label>Buscar <input name="q" value="@Model.Q" placeholder="Nombre o código" /></label>
    <label>Estado
        <select name="status" data-autosubmit>
            <option value="All" selected="@(Model.Status == StockFilter.All)">Todos</option>
            <option value="InStock" selected="@(Model.Status == StockFilter.InStock)">Con existencia</option>
            <option value="Out" selected="@(Model.Status == StockFilter.Out)">Agotados</option>
            <option value="Low" selected="@(Model.Status == StockFilter.Low)">Existencia baja</option>
            <option value="Approaching" selected="@(Model.Status == StockFilter.Approaching)">Cerca del mínimo</option>
            <option value="LowOrOut" selected="@(Model.Status == StockFilter.LowOrOut)">Bajos o agotados</option>
        </select>
    </label>
    <label>Dueño
        <select name="ownerId" data-autosubmit>
            <option value="">Todos</option>
            @foreach (var o in Model.Owners) { <option value="@o.Id" selected="@(Model.OwnerId == o.Id)">@o.Name</option> }
        </select>
    </label>
    <label>Categoría
        <select name="categoryId" data-autosubmit>
            <option value="">Todas</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }
        </select>
    </label>
    <label>Proveedor
        <select name="supplierId" data-autosubmit>
            <option value="">Todos</option>
            @foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option> }
        </select>
    </label>
    <button class="btn">Filtrar</button>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>Producto</th><th>Categoría</th><th class="num">Existencia</th><th class="num">Mínimo</th><th>Por dueño</th>
        <th class="num">Compra</th><th class="num">Venta</th>@if (Model.IsManager) { <th class="num">Valor a costo</th> }<th>Estado</th></tr></thead>
    <tbody>
    @foreach (var r in Model.Result.Items)
    {
        <tr>
            <td><a href="/Inventory/Product?id=@r.ProductId">@r.Name</a><div class="muted small">@r.Barcode</div></td>
            <td>@r.CategoryName</td>
            <td class="num">@F.Q(r.Stock, r.Unit)</td>
            <td class="num">@(r.MinStock > 0 ? F.Q(r.MinStock, r.Unit) : "—")</td>
            <td class="small">@(string.Join(" · ", r.Owners.Select(o => $"{o.OwnerName}: {F.Q(o.Qty, r.Unit)}")))</td>
            <td class="num">@F.M(r.PurchasePriceCents)</td>
            <td class="num">@F.M(r.SalePriceCents)</td>
            @if (Model.IsManager) { <td class="num">@F.M(r.CostValueCents)</td> }
            <td><span class="badge @(r.Status switch { StockStatus.Out => "bad", StockStatus.Low => "warn", StockStatus.Approaching => "warn", _ => "ok" })">@r.StatusText</span></td>
        </tr>
    }
    @if (Model.Result.Items.Count == 0) { <tr><td colspan="9" class="muted">Sin resultados.</td></tr> }
    </tbody>
</table>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result, Request)" />
