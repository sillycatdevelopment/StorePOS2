@page
@model StorePos.Web.Pages.Stocking.EditModel
@{
    var l = Model.List;
    ViewData["Title"] = l.Name;
    var items = l.Items.OrderBy(i => l.GroupBy == StockingGroupBy.Owner ? i.Owner?.Name : i.Supplier?.Name).ThenBy(i => i.Description).ToList();
    long total = items.Sum(i => i.Product is null ? 0 : Money.LineAmount(i.EstimatedUnitCostCents, i.Quantity, i.Product.Unit));
}
<div class="toolbar">
    <h1>@l.Name <span class="badge">@DisplayNames.Of(l.Status)</span></h1><span class="spacer"></span>
    <a class="btn" href="/Reports/Export?handler=Stocking&listId=@l.Id">Excel</a>
    <a class="btn" href="#" data-print>Imprimir</a>
    @if (Model.Editable) { <a class="btn primary" href="/Stocking/Receive?id=@l.Id">Recibir mercancía…</a> }
</div>
<p class="muted small">Creada @F.DT(l.CreatedAt) por @l.CreatedByUser?.DisplayName@(l.IsAutoGenerated ? " (automática)" : "")@(l.PurchasedAt is null ? "" : " · comprada " + F.DT(l.PurchasedAt))@(l.ReceivedAt is null ? "" : " · recibida " + F.DT(l.ReceivedAt))</p>

<form method="post" asp-page-handler="Save" asp-route-id="@l.Id" class="card">
    <div class="form-grid no-print">
        <label>Nombre <input name="Name" value="@l.Name" maxlength="120" disabled="@(!Model.Editable)" /></label>
        <label>Agrupar
            <select name="GroupBy" disabled="@(!Model.Editable)">
                <option value="Supplier" selected="@(l.GroupBy == StockingGroupBy.Supplier)">Por proveedor</option>
                <option value="Owner" selected="@(l.GroupBy == StockingGroupBy.Owner)">Por dueño</option>
                <option value="None" selected="@(l.GroupBy == StockingGroupBy.None)">Sin agrupar</option>
            </select>
        </label>
        <label>Notas <input name="Notes" value="@l.Notes" maxlength="1000" disabled="@(!Model.Editable)" /></label>
    </div>
    <div class="table-wrap">
    <table>
        <thead><tr><th>Producto</th><th>Proveedor</th><th>Dueño</th><th class="num">Existencia</th><th class="num">Sugerido</th><th class="num">A comprar</th><th class="num">Costo unit.</th><th class="num">Importe</th><th>Motivo</th>@if (Model.Editable) { <th>Quitar</th> }</tr></thead>
        <tbody>
        @{ int n = 0; string? lastGroup = null; }
        @foreach (var i in items)
        {
            var group = l.GroupBy switch { StockingGroupBy.Owner => i.Owner?.Name ?? "Sin dueño", StockingGroupBy.Supplier => i.Supplier?.Name ?? "Sin proveedor", _ => null };
            if (group is not null && group != lastGroup) { lastGroup = group; <tr><td colspan="10"><strong>@group</strong></td></tr> }
            var unit = i.Product?.Unit ?? UnitType.Piece;
            <tr>
                <td>@i.Description @if (i.ProductId is null) { <span class="badge warn">no registrado</span> }
                    <input type="hidden" name="Rows[@n].ItemId" value="@i.Id" /></td>
                <td><select name="Rows[@n].SupplierId" disabled="@(!Model.Editable)"><option value="">—</option>@foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(i.SupplierId == s.Id)">@s.Name</option> }</select></td>
                <td><select name="Rows[@n].OwnerId" disabled="@(!Model.Editable)"><option value="">—</option>@foreach (var o in Model.Owners) { <option value="@o.Id" selected="@(i.OwnerId == o.Id)">@o.Name</option> }</select></td>
                <td class="num">@(i.ProductId is null ? "—" : F.Q(i.CurrentStock, unit))</td>
                <td class="num">@(i.ProductId is null ? i.SuggestedQty.ToString() : F.Q(i.SuggestedQty, unit))</td>
                <td class="num"><input class="qty" name="Rows[@n].Qty" type="number" min="0" step="@(unit == UnitType.Kilogram ? "0.001" : "1")" value="@F.QIn(i.Quantity, unit)" disabled="@(!Model.Editable)" /></td>
                <td class="num"><input class="money" name="Rows[@n].Cost" type="number" min="0" step="0.01" value="@F.P(i.EstimatedUnitCostCents)" disabled="@(!Model.Editable)" /></td>
                <td class="num">@(i.Product is null ? "—" : F.M(Money.LineAmount(i.EstimatedUnitCostCents, i.Quantity, unit)))</td>
                <td class="small">@i.Reason</td>
                @if (Model.Editable) { <td><input type="checkbox" name="Rows[@n].Remove" value="true" /></td> }
            </tr>
            n++;
        }
        <tr class="total"><td colspan="7">Total estimado</td><td class="num">@F.M(total)</td><td colspan="2"></td></tr>
        </tbody>
    </table>
    </div>
    @if (Model.Editable) { <button class="btn primary no-print">Guardar cambios</button> }
</form>

@if (Model.Editable)
{
    <div class="grid c2 no-print">
        <form method="post" asp-page-handler="Add" asp-route-id="@l.Id" class="card toolbar">
            <label>Agregar producto (código o nombre) <input name="product" required /></label>
            <label>Cantidad <input name="qty" type="number" step="0.001" min="0.001" value="1" required /></label>
            <button class="btn">Agregar</button>
        </form>
        <div class="card actions">
            @if (l.Status == StockingListStatus.Draft)
            {
                <form method="post" asp-page-handler="Status" asp-route-id="@l.Id"><input type="hidden" name="status" value="Purchased" /><button class="btn">Marcar como comprada / pedida</button></form>
            }
            <form method="post" asp-page-handler="Status" asp-route-id="@l.Id" data-confirm="¿Cancelar esta lista?"><input type="hidden" name="status" value="Cancelled" /><button class="btn danger">Cancelar lista</button></form>
        </div>
    </div>
}
<form method="post" asp-page-handler="Delete" asp-route-id="@l.Id" class="no-print" data-confirm="¿Eliminar esta lista? Lo que ya se recibió de ella se queda en el inventario.">
    <button class="btn small danger">Eliminar lista</button>
</form>
