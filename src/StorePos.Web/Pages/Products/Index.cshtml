@page
@model StorePos.Web.Pages.Products.IndexModel
@{ ViewData["Title"] = "Productos"; }
<div class="toolbar">
    <h1>Productos</h1><span class="spacer"></span>
    @if (Model.IsManager)
    {
        <a class="btn" href="/Products/Categories">Categorías</a>
        <a class="btn primary" href="/Products/Edit">+ Nuevo producto</a>
    }
</div>
<form method="get" class="toolbar card">
    <label>Buscar <input name="q" value="@Model.Q" placeholder="Nombre o código" autofocus /></label>
    <label>Categoría
        <select name="categoryId" data-autosubmit>
            <option value="">Todas</option>
            @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }
        </select>
    </label>
    <label>Proveedor
        <select name="supplierId" data-autosubmit>
            <option value="">Todos</option>
            @foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option> }
        </select>
    </label>
    <label>Estado
        <select name="active" data-autosubmit>
            <option value="1" selected="@(Model.Active == "1")">Activos</option>
            <option value="0" selected="@(Model.Active == "0")">Inactivos</option>
            <option value="all" selected="@(Model.Active == "all")">Todos</option>
        </select>
    </label>
    <button class="btn">Filtrar</button>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>Producto</th><th>Código</th><th>Categoría</th><th>Proveedor</th><th class="num">Compra</th><th class="num">Venta</th><th class="num">Margen</th><th class="num">Existencia</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.Result.Items)
    {
        var margin = p.SalePriceCents == 0 ? 0 : (p.SalePriceCents - p.PurchasePriceCents) / (double)p.SalePriceCents;
        <tr>
            <td>@p.Name @if (!p.IsActive) { <span class="badge">inactivo</span> }</td>
            <td>@p.Barcode</td><td>@p.CategoryName</td><td>@p.SupplierName</td>
            <td class="num">@F.M(p.PurchasePriceCents)</td>
            <td class="num">@F.M(p.SalePriceCents)@(p.Unit == UnitType.Kilogram ? "/kg" : "")</td>
            <td class="num">@F.Pct(margin)</td>
            <td class="num"><span class="badge @(p.Stock <= 0 ? "bad" : p.MinStock > 0 && p.Stock <= p.MinStock ? "warn" : "ok")">@F.Q(p.Stock, p.Unit)</span></td>
            <td class="actions">
                <a class="btn small" href="/Inventory/Product?id=@p.Id">Inventario</a>
                @if (Model.IsManager) { <a class="btn small" href="/Products/Edit?id=@p.Id">Editar</a> }
            </td>
        </tr>
    }
    @if (Model.Result.Items.Count == 0) { <tr><td colspan="9" class="muted">No hay productos con esos filtros.</td></tr> }
    </tbody>
</table>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result, Request)" />
