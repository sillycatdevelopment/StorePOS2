@page
@model StorePos.Web.Pages.Cash.HistoryModel
@{ ViewData["Title"] = "Cortes de caja"; }
<h1>Cortes de caja</h1>
<form method="get" class="toolbar card">
    <partial name="_PeriodPicker" model="(Model.Period, Model.Range.From, Model.Range.To)" />
    <button class="btn">Ver</button>
    <button class="btn" name="handler" value="Export">Exportar a Excel</button>
</form>
<div class="table-wrap">
<table>
    <thead><tr><th>#</th><th>Fecha</th><th>Estado</th><th class="num">Ventas</th><th class="num">Efectivo esperado</th><th class="num">Contado</th><th class="num">Diferencia</th><th class="num">Ganancia</th><th>Cerró</th></tr></thead>
    <tbody>
    @foreach (var d in Model.Result.Items)
    {
        <tr><td><a href="/Cash/Details?id=@d.Id">@d.Id</a></td><td>@F.D(d.BusinessDate)</td>
            <td>@(d.Status == ClosingStatus.Open ? "Abierta" : "Cerrada")</td>
            <td class="num">@(d.Status == ClosingStatus.Closed ? F.M(d.TotalSalesCents) : "—")</td>
            <td class="num">@(d.Status == ClosingStatus.Closed ? F.M(d.ExpectedCashCents) : "—")</td>
            <td class="num">@(d.Status == ClosingStatus.Closed ? F.M(d.CountedCashCents) : "—")</td>
            <td class="num" style="color:@(d.DifferenceCents == 0 ? "inherit" : "var(--bad)")">@(d.Status == ClosingStatus.Closed ? F.M(d.DifferenceCents) : "—")</td>
            <td class="num">@(d.Status == ClosingStatus.Closed ? F.M(d.GrossProfitCents) : "—")</td>
            <td>@d.ClosedByUser?.DisplayName</td></tr>
    }
    </tbody>
</table>
</div>
<partial name="_Pager" model="PagerModel.From(Model.Result, Request)" />
