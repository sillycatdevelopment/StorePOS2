@page
@model StorePos.Web.Pages.Stocking.IndexModel
@{ ViewData["Title"] = "Listas de surtido"; }
<h1>Surtido y reabastecimiento</h1>
<div class="grid c2">
    <form method="post" asp-page-handler="Generate" class="card">
        <h2>Generar lista automática</h2>
        <div class="form-grid">
            <label>Nombre <input name="name" placeholder="Ej. Pedido Bimbo lunes" maxlength="120" /></label>
            <label>Agrupar por
                <select name="groupBy"><option value="Supplier">Proveedor</option><option value="Owner">Dueño</option><option value="None">Sin agrupar</option></select>
            </label>
            <label>Solo proveedor <select name="supplierId"><option value="">Todos</option>@foreach (var s in Model.Suppliers) { <option value="@s.Id">@s.Name</option> }</select></label>
            <label>Solo dueño <select name="ownerId"><option value="">Todos</option>@foreach (var o in Model.Owners) { <option value="@o.Id">@o.Name</option> }</select></label>
        </div>
        <label class="check"><input type="checkbox" name="includeRequests" value="true" checked /> Incluir productos nuevos que piden los clientes</label>
        <button class="btn primary">Generar lista</button>
        <p class="muted small">Generar una lista no compra nada ni modifica el inventario. La mercancía entra al inventario solo cuando la marcas como recibida.</p>
    </form>
    <div class="card">
        <h2>Listas recientes</h2>
        <form method="post" asp-page-handler="Empty" class="toolbar">
            <input name="name" placeholder="Nombre de lista manual" maxlength="120" required />
            <select name="groupBy"><option value="Supplier">Por proveedor</option><option value="Owner">Por dueño</option><option value="None">Sin agrupar</option></select>
            <button class="btn">Crear lista vacía</button>
        </form>
        <table>
            <thead><tr><th>#</th><th>Nombre</th><th>Fecha</th><th class="num">Renglones</th><th>Estado</th></tr></thead>
            <tbody>
            @foreach (var l in Model.Lists)
            {
                <tr><td>@l.Id</td><td><a href="/Stocking/Edit?id=@l.Id">@l.Name</a></td><td>@F.D(l.CreatedAt)</td><td class="num">@l.Items.Count</td>
                    <td><span class="badge @(l.Status == StockingListStatus.Received ? "ok" : l.Status == StockingListStatus.Purchased ? "warn" : "")">@DisplayNames.Of(l.Status)</span></td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="toolbar">
        <h2 style="margin:0">Sugerencias de compra (@Model.Suggestions.Count)</h2><span class="spacer"></span>
        <form method="get" class="toolbar" style="margin:0">
            <select name="supplierId" data-autosubmit><option value="">Todos los proveedores</option>@foreach (var s in Model.Suppliers) { <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option> }</select>
            <select name="ownerId" data-autosubmit><option value="">Todos los dueños</option>@foreach (var o in Model.Owners) { <option value="@o.Id" selected="@(Model.OwnerId == o.Id)">@o.Name</option> }</select>
        </form>
    </div>
    <div class="table-wrap">
    <table>
        <thead><tr><th>Producto</th><th>Proveedor</th><th class="num">Existencia</th><th class="num">Mínimo</th><th class="num">Venta diaria</th>
            <th class="num">Próx. entrega</th><th class="num">Alcanza para</th><th class="num">Sugerido</th><th>Motivo</th></tr></thead>
        <tbody>
        @foreach (var s in Model.Suggestions)
        {
            <tr>
                <td><a href="/Inventory/Product?id=@s.ProductId">@s.Name</a></td><td>@(s.SupplierName ?? "—")</td>
                <td class="num">@F.Q(s.CurrentStock, s.Unit)</td><td class="num">@F.Q(s.MinStock, s.Unit)</td>
                <td class="num">@F.Q((long)Math.Round(s.AvgDailySales), s.Unit)@(s.Reliable ? "" : "*")</td>
                <td class="num">@s.DaysToNextDelivery d</td>
                <td class="num">@(s.DaysOfCover is double c ? c.ToString("0.#") + " d" : "—")</td>
                <td class="num"><strong>@F.Q(s.SuggestedQty, s.Unit)</strong></td>
                <td class="small">@(string.Join("; ", s.Reasons))</td>
            </tr>
        }
        @if (Model.Suggestions.Count == 0) { <tr><td colspan="9" class="muted">Nada que resurtir por ahora.</td></tr> }
        </tbody>
    </table>
    </div>
    <p class="muted small">Sugerido = venta diaria × días entre entregas + existencia de seguridad − lo que quedará al llegar la próxima entrega. * = historial insuficiente: la venta diaria es solo orientativa.</p>
</div>

@if (Model.NewProductRequests.Count > 0)
{
    <div class="card">
        <h2>Productos nuevos que piden los clientes</h2>
        <ul class="list-plain">
            @foreach (var r in Model.NewProductRequests)
            {
                <li><span>@r.ProductName @if (r.Barcode is not null) { <span class="muted small">@r.Barcode</span> }</span>
                    <span><span class="badge warn">@r.RequestCount×</span> <a class="btn small" href="/Products/Edit?name=@Uri.EscapeDataString(r.ProductName)&barcode=@Uri.EscapeDataString(r.Barcode ?? "")">Dar de alta</a></span></li>
            }
        </ul>
    </div>
}
